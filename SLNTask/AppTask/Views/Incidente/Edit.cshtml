
@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Editar Incidente";
}

<div class="form-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">GERENCIAMENTO DE INCIDENTES</span>

            <h1>Editar Incidente</h1>

            <p>
                Atualize as informações do incidente selecionado.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon incident-form-icon">
                !
            </div>

            <div>
                <h2>Informações do incidente</h2>

                <p>
                    Altere os dados necessários abaixo.
                </p>
            </div>

        </div>


        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Codigo" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>


            <div class="input-group">

                <label asp-for="DescricaoProblema">
                    Descrição do Problema
                </label>

                <input asp-for="DescricaoProblema"
                       class="form-control"
                       placeholder="Digite a descrição do problema"
                       autocomplete="off" />

                <span asp-validation-for="DescricaoProblema"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label asp-for="DataIncidente">
                    Data do Incidente
                </label>

                <input asp-for="DataIncidente"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="DataIncidente"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label asp-for="Solucao">
                    Solução
                </label>

                <input asp-for="Solucao"
                       class="form-control"
                       placeholder="Digite a solução aplicada"
                       autocomplete="off" />

                <span asp-validation-for="Solucao"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label asp-for="Resolvido">
                    Resolvido
                </label>

                <select asp-for="Resolvido"
                        class="form-select">

                    <option value="">
                        -- Selecione --
                    </option>

                    <option value="Sim">
                        Sim
                    </option>

                    <option value="Não">
                        Não
                    </option>

                </select>

                <span asp-validation-for="Resolvido"
                      class="text-danger">
                </span>

            </div>


            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Alterações
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

