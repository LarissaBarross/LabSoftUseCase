@model IEnumerable<AppTask.Models.Incidente>

@{
    ViewData["Title"] = "Incidentes";
}

<div class="task-page">

    <!-- Cabeçalho -->
    <div class="page-header">
        <div>
            <span class="page-subtitle">GERENCIAMENTO</span>
            <h1>Incidentes</h1>
            <p>Gerencie os incidentes registrados no sistema.</p>
        </div>

        <a asp-action="Create" class="new-task">
            ＋ Novo incidente
        </a>
    </div>

    <!-- Resumo -->
    <div class="summary">

        <div class="summary-card">
            <div class="summary-icon purple">!</div>
            <div>
                <span>Total de incidentes</span>
                <strong>@Model.Count()</strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon orange">◷</div>
            <div>
                <span>Não resolvidos</span>
                <strong>
                    @Model.Count(x => x.Resolvido == "Não")
                </strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon green">✓</div>
            <div>
                <span>Resolvidos</span>
                <strong>
                    @Model.Count(x => x.Resolvido == "Sim")
                </strong>
            </div>
        </div>

    </div>

    <!-- Lista -->
    <div class="list-header">
        <div>
            <h2>Lista de incidentes</h2>
            <p>Incidentes cadastrados no sistema</p>
        </div>

        <span class="total-badge">
            @Model.Count() registros
        </span>
    </div>

    <div class="tasks-container">

        @if (!Model.Any())
        {
            <div class="empty">
                <div class="empty-icon">!</div>
                <h3>Nenhum incidente cadastrado</h3>
                <p>Cadastre um novo incidente para começar.</p>

                <a asp-action="Create" class="new-task">
                    ＋ Novo incidente
                </a>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="task-card">

                    <div class="task-top">

                        <div>
                            <span class="task-code">
                                INCIDENTE #@item.Codigo
                            </span>

                            <h3>
                                @item.DescricaoProblema
                            </h3>
                        </div>

                        @if (item.Resolvido == "Sim")
                        {
                            <span class="task-status status-done">
                                Resolvido
                            </span>
                        }
                        else
                        {
                            <span class="task-status status-pending">
                                Pendente
                            </span>
                        }

            </div>

            <div class="task-details">

                <div class="detail">
                    <span class="detail-icon">◷</span>

                    <div>
                        <small>Data do incidente</small>
                        <strong>
                            @item.DataIncidente
                        </strong>
                    </div>
                </div>

                <div class="detail">
                    <span class="detail-icon">✓</span>

                    <div>
                        <small>Solução</small>
                        <strong>
                            @(string.IsNullOrWhiteSpace(item.Solucao)
                                                        ? "Nenhuma solução registrada"
                                                        : item.Solucao)
                        </strong>
                    </div>
                </div>

                        <div class="detail">
                            <span class="detail-icon">!</span>

                            <div>
                                <small>Status</small>
                                <strong>
                                    @item.Resolvido
                                </strong>
                            </div>
                        </div>

                    </div>

                    <div class="task-card-footer">

                        <div class="task-actions">

                            <a asp-action="Details"
                               asp-route-id="@item.Codigo"
                               class="action view">
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Codigo"
                               class="action edit">
                                Editar
                            </a>

                            <button type="button"
                                    class="action delete"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-id="@item.Codigo"
                                    data-descricao="@item.DescricaoProblema"
                                    data-action="/Incidente/Delete/@item.Codigo">
                                Excluir
                            </button>

                        </div>

                    </div>

                </div>
                }
        }

    </div>

</div>


<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delete-modal">

            <div class="modal-header-custom">

                <div class="warning-icon">!</div>

                <button type="button"
                        class="close-button"
                        data-bs-dismiss="modal">
                    ×
                </button>

            </div>

            <div class="modal-body-custom">

                <h3>Confirmação de Exclusão</h3>

                <p>
                    Deseja realmente excluir o incidente:
                </p>

                <strong id="incidenteDescricao"></strong>

                <p class="warning-text">
                    Essa ação não poderá ser desfeita.
                </p>

            </div>

            <div class="modal-actions">

                <button type="button"
                        class="cancel-button"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="confirm-delete">
                        Sim, Excluir
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            var descricao =
                button.getAttribute('data-descricao');

            var action =
                button.getAttribute('data-action');

            document.getElementById('incidenteDescricao').textContent =
                descricao;

            document.getElementById('deleteForm').action =
                action;

        });

    </script>

}