@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Detalhes do Incidente";
}

<div class="form-page">

    <!-- Cabeçalho -->
    <div class="page-header">

        <div>
            <span class="page-subtitle">GERENCIAMENTO</span>

            <h1>Detalhes do Incidente</h1>

            <p>
                Consulte as informações do incidente cadastrado.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <!-- Card de detalhes -->
    <div class="form-card details-card">

        <div class="form-card-header">

            <div class="form-icon incident-form-icon">
                !
            </div>

            <div>
                <h2>Informações do incidente</h2>

                <p>
                    Dados cadastrados no sistema.
                </p>
            </div>

        </div>


        <!-- Informações -->

        <div class="details-content">

            <div class="details-item">

                <span class="details-label">
                    Descrição do Problema
                </span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.DescricaoProblema)
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Data do Incidente
                </span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.DataIncidente)
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Solução
                </span>

                <strong class="details-value">
                    @(string.IsNullOrWhiteSpace(Model.Solucao)
                                        ? "Nenhuma solução registrada"
                                        : Model.Solucao)
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Resolvido
                </span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.Resolvido)
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Código do Incidente
                </span>

                <strong class="details-value">
                    #@Model.Codigo
                </strong>

            </div>

        </div>


        <!-- Botões -->

        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-button">
                Voltar
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model?.Codigo"
               class="save-button details-edit-button">
                ✎ Editar
            </a>

        </div>

    </div>

</div>