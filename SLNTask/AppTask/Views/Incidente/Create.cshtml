@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Novo Incidente";
}

<div class="form-page">

    <!-- Cabeçalho -->
    <div class="page-header">

        <div>
            <span class="page-subtitle">GERENCIAMENTO</span>

            <h1>Novo Incidente</h1>

            <p>
                Registre um novo incidente no sistema.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <!-- Formulário -->
    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon incident-form-icon">
                !
            </div>

            <div>
                <h2>Informações do incidente</h2>

                <p>
                    Preencha os dados abaixo para registrar o incidente.
                </p>
            </div>

        </div>


        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>


            <div class="input-group">

                <label asp-for="DescricaoProblema">
                    Descrição do Problema
                </label>

                <input asp-for="DescricaoProblema"
                       class="form-control"
                       placeholder="Digite a descrição do problema"
                       autocomplete="off" />

                <span asp-validation-for="DescricaoProblema"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label asp-for="DataIncidente">
                    Data do Incidente
                </label>

                <input asp-for="DataIncidente"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="DataIncidente"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label asp-for="Solucao">
                    Solução
                </label>

                <input asp-for="Solucao"
                       class="form-control"
                       placeholder="Digite a solução aplicada"
                       autocomplete="off" />

                <span asp-validation-for="Solucao"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label asp-for="Resolvido">
                    Resolvido
                </label>

                <input asp-for="Resolvido"
                       class="form-control"
                       placeholder="Ex: Sim ou Não"
                       autocomplete="off" />

                <span asp-validation-for="Resolvido"
                      class="text-danger">
                </span>

            </div>


            <!-- Botões -->
            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Incidente
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}