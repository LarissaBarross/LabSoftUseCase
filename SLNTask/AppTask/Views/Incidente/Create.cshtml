
@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Novo Incidente";
}

<div class="form-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">
                GERENCIAMENTO DE INCIDENTES
            </span>

            <h1>Novo Incidente</h1>

            <p>
                Cadastre um novo incidente no sistema.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon incident-form-icon">
                !
            </div>

            <div>
                <h2>Informações do incidente</h2>

                <p>
                    Preencha os dados abaixo para cadastrar o incidente.
                </p>
            </div>

        </div>


        <form action="/Incidente/Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>


            <div class="input-group">

                <label for="DescricaoProblema">
                    Descrição do Problema
                </label>

                <input type="text"
                       id="DescricaoProblema"
                       name="DescricaoProblema"
                       class="form-control"
                       placeholder="Digite a descrição do problema"
                       autocomplete="off"
                       required />

                <span asp-validation-for="DescricaoProblema"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label for="DataIncidente">
                    Data do Incidente
                </label>

                <input type="datetime-local"
                       id="DataIncidente"
                       name="DataIncidente"
                       class="form-control"
                       required />

                <span asp-validation-for="DataIncidente"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label for="Solucao">
                    Solução
                </label>

                <input type="text"
                       id="Solucao"
                       name="Solucao"
                       class="form-control"
                       placeholder="Digite a solução aplicada"
                       autocomplete="off" />

                <span asp-validation-for="Solucao"
                      class="text-danger">
                </span>

            </div>


            <div class="input-group">

                <label for="Resolvido">
                    Resolvido
                </label>

                <select id="Resolvido"
                        name="Resolvido"
                        class="form-select"
                        required>

                    <option value="">
                        -- Selecione --
                    </option>

                    <option value="Sim">
                        Sim
                    </option>

                    <option value="Não">
                        Não
                    </option>

                </select>

                <span asp-validation-for="Resolvido"
                      class="text-danger">
                </span>

            </div>


            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Incidente
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

