@model AppTask.Models.CentralCusto

@{
    ViewData["Title"] = "Editar Central de Custo";
}

<div class="form-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">
                CONTROLE FINANCEIRO
            </span>

            <h1>Editar Central de Custo</h1>

            <p>
                Atualize as informações do centro de custo.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon central-form-icon">
                R$
            </div>

            <div>
                <h2>Informações do centro de custo</h2>

                <p>
                    Altere os dados abaixo e salve as modificações.
                </p>
            </div>

        </div>


        <div asp-validation-summary="ModelOnly"
             class="validation-message">
        </div>


        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Codigo" />


            <!-- NOME DO CUSTO -->

            <div class="input-group">

                <label asp-for="NomeCusto">
                    Nome do Custo
                </label>

                <input asp-for="NomeCusto"
                       class="form-control"
                       placeholder="Digite o nome do custo" />

                <small class="field-help">
                    Informe o nome para identificar este centro de custo.
                </small>

                <span asp-validation-for="NomeCusto"
                      class="text-danger">
                </span>

            </div>


            <!-- VALOR -->

            <div class="input-group">

                <label asp-for="ValorAnualMeta">
                    Valor Anual da Meta
                </label>

                <div class="input-money">

                    <span>R$</span>

                    <input asp-for="ValorAnualMeta"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="0,00" />

                </div>

                <small class="field-help">
                    Informe o valor anual da meta deste centro.
                </small>

                <span asp-validation-for="ValorAnualMeta"
                      class="text-danger">
                </span>

            </div>


            <!-- BOTÕES -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">

                    Cancelar

                </a>


                <button type="submit"
                        class="save-button">

                    ✓ Salvar Alterações

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
