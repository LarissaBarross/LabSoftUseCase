@model AppTask.Models.CentralCusto

@{
    ViewData["Title"] = "Nova Central de Custo";
}

<div class="form-page">

    <!-- CABEÇALHO -->

    <div class="page-header">

        <div>
            <span class="page-subtitle">
                CONTROLE FINANCEIRO
            </span>

            <h1>
                Nova Central de Custo
            </h1>

            <p>
                Cadastre um novo centro de custo no sistema.
            </p>
        </div>

        <a asp-action="Index"
           class="back-button">
            ← Voltar
        </a>

    </div>


    <!-- FORMULÁRIO -->

    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon central-form-icon">
                R$
            </div>

            <div>
                <h2>
                    Informações do centro de custo
                </h2>

                <p>
                    Preencha os dados abaixo para realizar o cadastro.
                </p>
            </div>

        </div>


        <!-- ERROS -->

        <div asp-validation-summary="All"
             class="validation-message">
        </div>


        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <!-- NOME DO CUSTO -->

            <div class="input-group">

                <label for="NomeCusto">
                    Nome do Custo
                </label>

                <input type="text"
                       id="NomeCusto"
                       name="NomeCusto"
                       class="form-control"
                       placeholder="Digite o nome do custo"
                       required />

                <small class="field-help">
                    Informe um nome para identificar este centro de custo.
                </small>

            </div>


            <!-- VALOR -->

            <div class="input-group">

                <label for="ValorAnualMeta">
                    Valor Anual da Meta
                </label>

                <div class="input-money">

                    <span>R$</span>

                    <input type="number"
                           id="ValorAnualMeta"
                           name="ValorAnualMeta"
                           placeholder="0,00"
                           step="0.01"
                           min="0"
                           required />

                </div>

                <small class="field-help">
                    Informe o valor anual da meta deste centro.
                </small>

            </div>


            <!-- BOTÕES -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Central de Custo
                </button>

            </div>

        </form>

    </div>

</div>