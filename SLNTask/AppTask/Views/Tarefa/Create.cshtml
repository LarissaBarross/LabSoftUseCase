@model AppTask.Models.Tarefa
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Nova Tarefa";
}

<div class="form-page">

    <!-- CABEÇALHO -->

    <div class="page-header">

        <div>
            <span class="page-subtitle">GERENCIAMENTO DE TAREFAS</span>

            <h1>Nova Tarefa</h1>

            <p>
                Cadastre uma nova tarefa no sistema.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <!-- FORMULÁRIO -->

    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon task-form-icon">
                ✓
            </div>

            <div>
                <h2>Informações da tarefa</h2>

                <p>
                    Preencha os dados para cadastrar uma nova tarefa.
                </p>
            </div>

        </div>


        <!-- ERROS -->

        <div asp-validation-summary="All"
             class="validation-message">
        </div>


        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <!-- DESCRIÇÃO -->

            <div class="input-group">

                <label for="Descricao">
                    Descrição
                </label>

                <input type="text"
                       id="Descricao"
                       name="Descricao"
                       class="form-control"
                       placeholder="Digite a descrição da tarefa"
                       required />

            </div>


            <!-- DATAS -->

            <div class="form-grid">

                <div class="input-group">

                    <label for="DataPlanejada">
                        Data Planejada
                    </label>

                    <input type="datetime-local"
                           id="DataPlanejada"
                           name="DataPlanejada"
                           class="form-control"
                           required />

                </div>


                <div class="input-group">

                    <label for="DataIniciada">
                        Data Iniciada
                    </label>

                    <input type="datetime-local"
                           id="DataIniciada"
                           name="DataIniciada"
                           class="form-control" />

                </div>


                <div class="input-group">

                    <label for="DataFinalizada">
                        Data Finalizada
                    </label>

                    <input type="datetime-local"
                           id="DataFinalizada"
                           name="DataFinalizada"
                           class="form-control" />

                </div>


                <div class="input-group">

                    <label for="DataCancelada">
                        Data Cancelada
                    </label>

                    <input type="datetime-local"
                           id="DataCancelada"
                           name="DataCancelada"
                           class="form-control" />

                </div>

            </div>


            <!-- STATUS E PRAZO -->

            <div class="form-grid">

                <div class="input-group">

                    <label for="StatusTarefa">
                        Status da Tarefa
                    </label>

                    <select id="StatusTarefa"
                            name="StatusTarefa"
                            class="form-control"
                            required>

                        <option value="">
                            -- Selecione o Status --
                        </option>

                        <option value="Pendente">
                            Pendente
                        </option>

                        <option value="Em Andamento">
                            Em Andamento
                        </option>

                        <option value="Concluído">
                            Concluído
                        </option>

                        <option value="Cancelado">
                            Cancelado
                        </option>

                    </select>

                </div>


                <div class="input-group">

                    <label for="Prazo">
                        Prazo
                    </label>

                    <input type="text"
                           id="Prazo"
                           name="Prazo"
                           class="form-control"
                           placeholder="Ex: Em dia, Em atraso"
                           required />

                </div>

            </div>


            <!-- FUNCIONÁRIO -->

            <div class="input-group">

                <label for="FuncionarioId">
                    Funcionário Responsável
                </label>

                <select asp-for="FuncionarioId"
                        class="form-control"
                        asp-items="ViewBag.ListaFuncionario"
                        required>

                    <option value="">
                        -- Selecione um Funcionário --
                    </option>

                </select>

            </div>


            <!-- BOTÕES -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Tarefa
                </button>

            </div>

        </form>

    </div>

</div>