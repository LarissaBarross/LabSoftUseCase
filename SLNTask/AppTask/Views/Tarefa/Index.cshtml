@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefas";
}

<div class="task-page">

    <!-- CABEÇALHO -->
    <div class="page-header">

        <div>
            <span class="page-subtitle">GERENCIAMENTO DE TAREFAS</span>

            <h1>Lista de Tarefas</h1>

            <p>
                Gerencie as tarefas cadastradas no sistema.
            </p>
        </div>

        <a asp-action="Create" class="new-task">
            <span>＋</span>
            Nova tarefa
        </a>

    </div>


    <!-- RESUMO -->
    <div class="summary">

        <div class="summary-card">
            <div class="summary-icon purple">✓</div>

            <div>
                <small>Total de tarefas</small>
                <strong>@Model.Count()</strong>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon orange">◷</div>

            <div>
                <small>Pendentes</small>

                <strong>
                    @Model.Count(x => x.StatusTarefa == "Pendente")
                </strong>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon green">✓</div>

            <div>
                <small>Concluídas</small>

                <strong>
                    @Model.Count(x => x.StatusTarefa == "Concluído")
                </strong>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon red">×</div>

            <div>
                <small>Canceladas</small>

                <strong>
                    @Model.Count(x => x.StatusTarefa == "Cancelado")
                </strong>
            </div>
        </div>

    </div>


    <!-- PESQUISA -->
    <div class="search-area">

        <div class="search-box">

            <span>⌕</span>

            <input type="text"
                   id="taskSearch"
                   placeholder="Pesquisar tarefa..." />

        </div>

    </div>


    <!-- TÍTULO DA LISTA -->
    <div class="list-header">

        <h2>Tarefas cadastradas</h2>

        <span class="total-badge">
            @Model.Count() registros
        </span>

    </div>


    <!-- LISTA -->
    @if (!Model.Any())
    {
        <div class="empty">

            <div class="empty-icon">✓</div>

            <h3>Nenhuma tarefa cadastrada</h3>

            <p>
                Ainda não existem tarefas cadastradas no sistema.
            </p>

            <a asp-action="Create" class="new-task">
                ＋ Nova tarefa
            </a>

        </div>
    }
    else
    {
        <div class="tasks-container">

            @foreach (var item in Model)
            {
                <div class="task-card"
                     data-task-search="@item.Descricao @item.StatusTarefa @item.Prazo @item.Funcionario?.Nome">

                    <!-- TOPO -->
                    <div class="task-top">

                        <span class="task-code">
                            #@item.Codigo
                        </span>


                        @{
                            var statusClass = item.StatusTarefa switch
                            {
                                "Pendente" => "status-pending",
                                "Em Andamento" => "status-progress",
                                "Concluído" => "status-completed",
                                "Cancelado" => "status-cancelled",
                                _ => "status-default"
                            };
                        }

                        <span class="task-status @statusClass">
                            @item.StatusTarefa
                        </span>

                    </div>


                    <!-- DESCRIÇÃO -->
                    <h3>
                        @item.Descricao
                    </h3>


                    <!-- INFORMAÇÕES -->
                    <div class="task-details">

                        <div class="detail">

                            <div class="detail-icon">
                                📅
                            </div>

                            <div>
                                <small>Data planejada</small>

                                <strong>
                                    @item.DataPlanejada
                                </strong>
                            </div>

                        </div>


                        <div class="detail">

                            <div class="detail-icon">
                                ⏱
                            </div>

                            <div>
                                <small>Prazo</small>

                                <strong>
                                    @item.Prazo
                                </strong>
                            </div>

                        </div>


                        <div class="detail">

                            <div class="detail-icon">
                                ▶
                            </div>

                            <div>
                                <small>Data iniciada</small>

                                <strong>
                                    @(item.DataIniciada?.ToString() ?? "Não iniciada")
                                </strong>
                            </div>

                        </div>


                        <div class="detail">

                            <div class="detail-icon">
                                ✓
                            </div>

                            <div>
                                <small>Data finalizada</small>

                                <strong>
                                    @(item.DataFinalizada?.ToString() ?? "Não finalizada")
                                </strong>
                            </div>

                        </div>

                    </div>


                    <!-- FUNCIONÁRIO -->
                    <div class="employee">

                        <div class="employee-avatar">

                            @(item.Funcionario?.Nome?.Substring(0, 1).ToUpper() ?? "?")

                        </div>

                        <div>

                            <small>Funcionário responsável</small>

                            <strong>
                                @(item.Funcionario?.Nome ?? "Sem funcionário")
                            </strong>

                        </div>

                    </div>


                    <!-- AÇÕES -->
                    <div class="task-actions">

                        <a asp-action="Details"
                           asp-route-id="@item.Codigo"
                           class="action view">
                            Detalhes
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Codigo"
                           class="action edit">
                            Alterar
                        </a>

                        <button type="button"
                                class="action delete"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@item.Codigo"
                                data-descricao="@item.Descricao">
                            Excluir
                        </button>

                    </div>

                </div>
            }

        </div>
    }

</div>


<!-- =====================================================
     MODAL DE CONFIRMAÇÃO DE EXCLUSÃO
===================================================== -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delete-modal">

            <div class="modal-header-custom">

                <div class="warning-icon">
                    !
                </div>

                <button type="button"
                        class="close-button"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                    ×
                </button>

            </div>


            <div class="modal-body-custom">

                <h3>
                    Confirmação de Exclusão
                </h3>

                <p>
                    Deseja realmente excluir a tarefa:
                </p>

                <strong id="tarefaDescricao"></strong>

            </div>


            <div class="modal-actions">

                <button type="button"
                        class="cancel-button"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>


                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="confirm-delete">
                        Sim, Excluir
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // PESQUISA
        const taskSearch = document.getElementById("taskSearch");

        if (taskSearch) {

            taskSearch.addEventListener("input", function () {

                const search = this.value.toLowerCase();

                document.querySelectorAll(".task-card").forEach(function (card) {

                    const text = card
                        .getAttribute("data-task-search")
                        .toLowerCase();

                    card.style.display =
                        text.includes(search) ? "" : "none";

                });

            });

        }


        // MODAL DE EXCLUSÃO
        const deleteModal = document.getElementById("deleteModal");

        if (deleteModal) {

            deleteModal.addEventListener("show.bs.modal", function (event) {

                const button = event.relatedTarget;

                const id = button.getAttribute("data-id");

                const descricao =
                    button.getAttribute("data-descricao");

                document.getElementById("tarefaDescricao")
                    .textContent = descricao;

                document.getElementById("deleteForm")
                    .action = "/Tarefa/Delete/" + id;

            });

        }

    </script>

}