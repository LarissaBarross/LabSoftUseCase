@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefas";
}

<div class="task-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">Organização</span>

            <h1>Tarefas</h1>

            <p>
                Acompanhe suas atividades de forma simples e organizada.
            </p>
        </div>

        <a asp-action="Create" class="new-task">
            <span>＋</span>
            Nova tarefa
        </a>

    </div>


    <!-- RESUMO -->

    <div class="summary">

        <div class="summary-card">

            <div class="summary-icon purple">
                ♡
            </div>

            <div>
                <small>Total de tarefas</small>

                <strong>
                    @Model.Count()
                </strong>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon orange">
                ◷
            </div>

            <div>
                <small>Pendentes</small>

                <strong>
                    @Model.Count(t => t.StatusTarefa == "Pendente")
                </strong>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon green">
                ✓
            </div>

            <div>
                <small>Concluídas</small>

                <strong>
                    @Model.Count(t => t.StatusTarefa == "Concluído")
                </strong>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon red">
                !
            </div>

            <div>
                <small>Canceladas</small>

                <strong>
                    @Model.Count(t => t.StatusTarefa == "Cancelado")
                </strong>
            </div>

        </div>

    </div>


    <!-- PESQUISA -->

    <div class="search-area">

        <div class="search-box">

            <span>⌕</span>

            <input type="text"
                   id="searchTask"
                   placeholder="Pesquisar tarefa..." />

        </div>

    </div>


    <!-- TÍTULO DA LISTA -->

    <div class="list-header">

        <h2>Lista de tarefas</h2>

        <span class="total-badge">
            @Model.Count() tarefas
        </span>

    </div>


    <!-- CARDS -->

    <div class="tasks-container">

        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="task-card"
                     data-task="@item.Descricao?.ToLower()">

                    <!-- TOPO -->

                    <div class="task-top">

                        <span class="task-code">
                            #@item.Codigo
                        </span>

                        <span class="task-status
                                    @(item.StatusTarefa == "Em Andamento" ? "status-progress" :
                                                            item.StatusTarefa == "Concluído" ? "status-completed" :
                                                            item.StatusTarefa == "Cancelado" ? "status-cancelled" :
                                                            item.StatusTarefa == "Pendente" ? "status-pending" :
                                                            "status-default")">

                            @item.StatusTarefa

                        </span>

                    </div>


                    <!-- DESCRIÇÃO -->

                    <h3>
                        @item.Descricao
                    </h3>


                    <!-- INFORMAÇÕES -->

                    <div class="task-details">

                        <div class="detail">

                            <div class="detail-icon">
                                ◷
                            </div>

                            <div>

                                <small>
                                    Data planejada
                                </small>

                                <strong>
                                    @item.DataPlanejada.ToString("dd/MM/yyyy HH:mm")
                                </strong>

                            </div>

                        </div>


                        <div class="detail">

                            <div class="detail-icon">
                                ♡
                            </div>

                            <div>

                                <small>
                                    Prazo
                                </small>

                                <strong>
                                    @item.Prazo
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- RESPONSÁVEL -->

                    <div class="employee">

                        <div class="employee-avatar">

                            @(
                                                item.Funcionario?.Nome?
                                                .Substring(0, 1)
                                                .ToUpper() ?? "?"
                                                )

                </div>

                        <div>

                            <small>
                                Responsável
                            </small>

                            <strong>
                                @(item.Funcionario?.Nome ?? "Não informado")
                            </strong>

                        </div>

                    </div>


                    <!-- AÇÕES -->

                    <div class="task-actions">

                        <a asp-action="Details"
                           asp-route-id="@item.Codigo"
                           class="action view">

                            Visualizar

                        </a>


                        <a asp-action="Edit"
                           asp-route-id="@item.Codigo"
                           class="action edit">

                            Editar

                        </a>


                        <!-- EXCLUIR -->

                        <button type="button"
                                class="action delete"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@item.Codigo"
                                data-name="@item.Descricao">

                            Excluir

                        </button>

                    </div>

                </div>
                }
        }
        else
        {
            <div class="empty">

                <div class="empty-icon">
                    ♡
                </div>

                <h3>
                    Nenhuma tarefa cadastrada
                </h3>

                <p>
                    Quando você cadastrar uma tarefa,
                    ela aparecerá aqui.
                </p>

                <a asp-action="Create" class="new-task">

                    <span>＋</span>
                    Nova tarefa

                </a>

            </div>
        }

    </div>


    <!-- =====================================================
         MODAL DE EXCLUSÃO
    ====================================================== -->

    <div class="modal fade"
         id="deleteModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content delete-modal">

                <!-- CABEÇALHO -->

                <div class="modal-header-custom">

                    <div class="warning-icon">
                        !
                    </div>

                    <button type="button"
                            class="close-button"
                            data-bs-dismiss="modal">

                        ×

                    </button>

                </div>


                <!-- MENSAGEM -->

                <div class="modal-body-custom">

                    <h3>
                        Excluir tarefa?
                    </h3>

                    <p>
                        Você realmente deseja excluir:
                    </p>

                    <strong id="tarefaNome"></strong>

                    <p class="warning-text">
                        Essa ação não poderá ser desfeita.
                    </p>

                </div>


                <!-- BOTÕES -->

                <div class="modal-actions">

                    <button type="button"
                            class="cancel-button"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <form id="deleteForm"
                          method="post"
                          action="">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="confirm-delete">

                            Sim, excluir

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        /* =====================================================
           PESQUISA
        ===================================================== */

        const searchInput =
            document.getElementById("searchTask");

        searchInput.addEventListener("input", function () {

            const search =
                this.value.toLowerCase();

            document.querySelectorAll(".task-card")
                .forEach(function (card) {

                    const task =
                        card.getAttribute("data-task") || "";

                    card.style.display =
                        task.includes(search)
                            ? ""
                            : "none";

                });

        });


        /* =====================================================
           MODAL DE EXCLUSÃO
        ===================================================== */

        const deleteModal =
            document.getElementById("deleteModal");


        deleteModal.addEventListener(
            "show.bs.modal",
            function (event) {

                const button =
                    event.relatedTarget;


                const id =
                    button.getAttribute("data-id");


                const nome =
                    button.getAttribute("data-name");


                /*
                 * Mostra o nome da tarefa
                 */

                document.getElementById(
                    "tarefaNome"
                ).textContent = nome;


                /*
                 * Define para qual tarefa
                 * o formulário irá enviar
                 */

                document.getElementById(
                    "deleteForm"
                ).action =
                    "/Tarefa/Delete/" + id;

            }
        );

    </script>

}