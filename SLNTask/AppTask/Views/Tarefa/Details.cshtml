@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Detalhes da Tarefa";
}

<div class="form-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">GERENCIAMENTO DE TAREFAS</span>

            <h1>Detalhes da Tarefa</h1>

            <p>
                Consulte as informações desta tarefa.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <div class="form-card details-card">

        <div class="form-card-header">

            <div class="form-icon task-form-icon">
                ✓
            </div>

            <div>
                <h2>Informações da tarefa</h2>

                <p>
                    Dados cadastrados no sistema.
                </p>
            </div>

        </div>


        <div class="details-content">

            <div class="details-item">
                <span class="details-label">Descrição</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.Descricao)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Data Planejada</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.DataPlanejada)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Data Iniciada</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.DataIniciada)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Data Finalizada</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.DataFinalizada)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Data Cancelada</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.DataCancelada)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Status da Tarefa</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.StatusTarefa)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Prazo</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.Prazo)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Funcionário Responsável</span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.Funcionario.Cargo)
                </strong>
            </div>


            <div class="details-item">
                <span class="details-label">Código da Tarefa</span>

                <strong class="details-value">
                    #@Model.Codigo
                </strong>
            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index" class="cancel-button">
                Voltar
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model?.Codigo"
               class="save-button details-edit-button">
                ✎ Editar
            </a>

        </div>

    </div>

</div>