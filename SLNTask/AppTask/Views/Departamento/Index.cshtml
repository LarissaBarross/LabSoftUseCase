@model IEnumerable<AppTask.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="list-page-header">

    <div>
        <div class="eyebrow">Cadastros</div>

        <h1>Departamentos</h1>

        <p>Gerencie os departamentos cadastrados no sistema.</p>
    </div>

    <a asp-action="Create" class="primary-btn">
        <span class="plus">＋</span>
        Novo departamento
    </a>

</div>


<div class="list-card">

    <div class="list-card-top">

        <h2>Lista de departamentos</h2>

        <span class="record-count">
            @Model.Count() registros
        </span>

    </div>


    <div class="table-scroll">

        <table class="data-table">

            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Ativo</th>
                    <th>Ações</th>
                </tr>
            </thead>


            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="empty-state">
                            Nenhum departamento cadastrado.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td class="strong-cell">
                                @item.Descricao
                            </td>


                            <td>
                                @item.Ativo
                            </td>


                            <td class="action-cell">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Codigo"
                                   class="table-action edit">
                                    Editar
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.Codigo"
                                   class="table-action view">
                                    Detalhes
                                </a>

                                <button type="button"
                                        class="table-action delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.Codigo"
                                        data-descricao="@item.Descricao">
                                    Excluir
                                </button>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>


<!-- Modal de Confirmação de Exclusão -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title"
                    id="deleteModalLabel">
                    Confirmação de Exclusão
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>

            </div>


            <div class="modal-body">

                Deseja realmente excluir o departamento:

                <strong id="departamentoDescricao"></strong>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">
                        Sim, Excluir
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        var deleteModal = document.getElementById("deleteModal");

        deleteModal.addEventListener("show.bs.modal", function (event) {

            var button = event.relatedTarget;

            var id = button.getAttribute("data-id");

            var descricao =
                button.getAttribute("data-descricao");

            document.getElementById("departamentoDescricao").textContent =
                descricao;

            document.getElementById("deleteForm").action =
                "/Departamento/Delete/" + id;

        });

    </script>

}