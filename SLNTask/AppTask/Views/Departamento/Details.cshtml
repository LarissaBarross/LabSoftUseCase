@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Detalhes do Departamento";
}

<div class="departamento-details-page">

    <div class="departamento-details-header">

        <div>
            <div class="eyebrow">CADASTROS</div>

            <h1>Detalhes do Departamento</h1>

            <p>
                Consulte as informações do departamento cadastrado.
            </p>
        </div>

        <a asp-action="Index" class="departamento-back">
            ← Voltar
        </a>

    </div>


    <div class="departamento-details-card">

        <div class="departamento-details-title">

            <div class="departamento-details-icon">
                D
            </div>

            <div>
                <h2>Informações do departamento</h2>

                <p>
                    Dados cadastrados no sistema.
                </p>
            </div>

        </div>


        <div class="departamento-info">

            <div class="departamento-info-item">

                <span class="departamento-info-label">
                    Descrição
                </span>

                <strong class="departamento-info-value">
                    @Html.DisplayFor(model => model.Descricao)
                </strong>

            </div>


            <div class="departamento-info-item">

                <span class="departamento-info-label">
                    Status
                </span>

                <strong class="departamento-info-value">
                    @Html.DisplayFor(model => model.Ativo)
                </strong>

            </div>


            <div class="departamento-info-item">

                <span class="departamento-info-label">
                    Código
                </span>

                <strong class="departamento-info-value">
                    #@Model.Codigo
                </strong>

            </div>

        </div>


        <div class="departamento-details-actions">

            <a asp-action="Index"
               class="departamento-back">
                Voltar
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model?.Codigo"
               class="departamento-edit">
                ✎ Editar
            </a>

        </div>

    </div>

</div>
