@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Novo Departamento";
}

<div class="form-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">CADASTROS</span>

            <h1>Novo Departamento</h1>

            <p>
                Cadastre um novo departamento no sistema.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon">
                D
            </div>

            <div>
                <h2>Informações do departamento</h2>

                <p>
                    Preencha os dados abaixo para cadastrar o departamento.
                </p>
            </div>

        </div>


        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>


            <!-- DESCRIÇÃO -->

            <div class="input-group">

                <label asp-for="Descricao">
                    Descrição
                </label>

                <input asp-for="Descricao"
                       class="form-control"
                       placeholder="Digite a descrição do departamento"
                       autocomplete="off" />

                <span asp-validation-for="Descricao"
                      class="text-danger">
                </span>

            </div>


            <!-- ATIVO -->

            <div class="input-group">

                <label asp-for="Ativo">
                    Ativo
                </label>

                <input asp-for="Ativo"
                       class="form-control"
                       placeholder="Digite o status"
                       autocomplete="off" />

                <span asp-validation-for="Ativo"
                      class="text-danger">
                </span>

            </div>


            <!-- BOTÕES -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Departamento
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}