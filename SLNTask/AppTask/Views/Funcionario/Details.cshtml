
@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Detalhes do Funcionário";
}

<div class="form-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">
                GERENCIAMENTO DE FUNCIONÁRIOS
            </span>

            <h1>Detalhes do Funcionário</h1>

            <p>
                Visualize as informações do funcionário selecionado.
            </p>
        </div>

        <a asp-action="Index"
           class="back-button">
            ← Voltar
        </a>

    </div>


    <div class="form-card details-card">

        <div class="form-card-header">

            <div class="form-icon funcionario-form-icon">
                👤
            </div>

            <div>
                <h2>Informações do funcionário</h2>

                <p>
                    Dados cadastrados no sistema.
                </p>
            </div>

        </div>


        <div class="details-content">

            <div class="details-item">

                <span class="details-label">
                    Nome completo
                </span>

                <strong class="details-value">
                    @Model.Nome
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Cargo
                </span>

                <strong class="details-value">
                    @Model.Cargo
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Gerente
                </span>

                <strong class="details-value">
                    @(Model.Gerente?.Nome ?? "Sem gerente")
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Código do Funcionário
                </span>

                <strong class="details-value">
                    #@Model.Codigo
                </strong>

            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-button">
                Voltar
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Codigo"
               class="save-button details-edit-button">
                ✎ Editar
            </a>

        </div>

    </div>

</div>
