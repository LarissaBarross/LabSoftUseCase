@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Detalhes do Funcionário";
}

<div class="form-page">

    <!-- Cabeçalho -->
    <div class="page-header">

        <div>
            <span class="page-subtitle">CADASTROS</span>

            <h1>Detalhes do Funcionário</h1>

            <p>
                Consulte as informações do funcionário cadastrado.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <!-- Card de detalhes -->
    <div class="form-card details-card">

        <div class="form-card-header">

            <div class="form-icon">
                👤
            </div>

            <div>
                <h2>Informações do funcionário</h2>

                <p>
                    Dados cadastrados no sistema.
                </p>
            </div>

        </div>


        <!-- Informações -->

        <div class="details-content">

            <div class="details-item">

                <span class="details-label">
                    Nome
                </span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.Nome)
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Cargo
                </span>

                <strong class="details-value">
                    @Html.DisplayFor(model => model.Cargo)
                </strong>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Código do Funcionário
                </span>

                <strong class="details-value">
                    #@Model.Codigo
                </strong>

            </div>

        </div>


        <!-- Botões -->

        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-button">
                Voltar
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model?.Codigo"
               class="save-button details-edit-button">
                ✎ Editar
            </a>

        </div>

    </div>

</div>