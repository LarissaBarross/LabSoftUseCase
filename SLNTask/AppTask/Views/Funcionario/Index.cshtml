
@model IEnumerable<AppTask.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}

<div class="task-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">CADASTROS</span>

            <h1>Funcionários</h1>

            <p>
                Gerencie os funcionários responsáveis pelas tarefas.
            </p>
        </div>

        <a asp-action="Create" class="new-task">
            <span>＋</span> Novo funcionário
        </a>

    </div>


    <div class="list-header">

        <h2>Lista de funcionários</h2>

        <span class="total-badge">
            @Model.Count() registros
        </span>

    </div>


    @if (!Model.Any())
    {
        <div class="empty">

            <div class="empty-icon">
                ♡
            </div>

            <h3>Nenhum funcionário cadastrado</h3>

            <p>
                Cadastre um novo funcionário para começar.
            </p>

        </div>
    }
    else
    {
        <div class="tasks-container">

            @foreach (var item in Model)
            {
                <div class="task-card">

                    <div class="task-top">

                        <span class="task-code">
                            #@item.Codigo
                        </span>

                        <span class="task-status status-progress">
                            Funcionário
                        </span>

                    </div>


                    <div class="task-info">

                        <h3>
                            @item.Nome
                        </h3>

                    </div>


                    <div class="task-details">

                        <div class="detail">

                            <span class="detail-icon">
                                ◉
                            </span>

                            <div>
                                <small>Cargo</small>

                                <strong>
                                    @item.Cargo
                                </strong>
                            </div>

                        </div>


                        <div class="detail">

                            <span class="detail-icon">
                                ♡
                            </span>

                            <div>
                                <small>Gerente</small>

                                <strong>
                                    @(item.Gerente?.Nome ?? "Sem gerente")
                                </strong>
                            </div>

                        </div>

                    </div>


                    <div class="task-actions">

                        <a asp-action="Details"
                           asp-route-id="@item.Codigo"
                           class="action view">
                            Detalhes
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Codigo"
                           class="action edit">
                            Editar
                        </a>

                        <button type="button"
                                class="action delete"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@item.Codigo"
                                data-descricao="@item.Nome">
                            Excluir
                        </button>

                    </div>

                </div>
            }

        </div>
    }

</div>


<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delete-modal">

            <div class="modal-header-custom">

                <div class="warning-icon">
                    !
                </div>

                <button type="button"
                        class="close-button"
                        data-bs-dismiss="modal">
                    ×
                </button>

            </div>


            <div class="modal-body-custom">

                <h3>
                    Confirmar exclusão
                </h3>

                <p>
                    Deseja realmente excluir o funcionário
                    <strong id="itemDescricao"></strong>?
                </p>

                <p class="warning-text">
                    Essa ação não poderá ser desfeita.
                </p>

            </div>


            <div class="modal-actions">

                <button type="button"
                        class="cancel-button"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="confirm-delete">
                        Sim, excluir
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const deleteModal =
            document.getElementById('deleteModal');

        if (deleteModal) {

            deleteModal.addEventListener(
                'show.bs.modal',
                function (event) {

                    const button =
                        event.relatedTarget;

                    document
                        .getElementById('itemDescricao')
                        .textContent =
                        button.dataset.descricao;

                    document
                        .getElementById('deleteForm')
                        .action =
                        '/Funcionario/Delete/' +
                        button.dataset.id;
                }
            );
        }

    </script>
}


