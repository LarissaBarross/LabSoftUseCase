
@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Novo Funcionário";
}

<div class="form-page">

    <div class="page-header">

        <div>
            <span class="page-subtitle">
                GERENCIAMENTO DE FUNCIONÁRIOS
            </span>

            <h1>Novo Funcionário</h1>

            <p>
                Cadastre um novo funcionário no sistema.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>

    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon funcionario-form-icon">
                👤
            </div>

            <div>
                <h2>Informações do funcionário</h2>

                <p>
                    Preencha os dados abaixo para realizar o cadastro.
                </p>
            </div>

        </div>

        <div asp-validation-summary="All"
             class="validation-message">
        </div>

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div class="input-group">

                <label asp-for="Nome">
                    Nome
                </label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Digite o nome do funcionário"
                       autocomplete="off" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>

            <div class="input-group">

                <label asp-for="Cargo">
                    Cargo
                </label>

                <input asp-for="Cargo"
                       class="form-control"
                       placeholder="Digite o cargo do funcionário"
                       autocomplete="off" />

                <span asp-validation-for="Cargo"
                      class="text-danger">
                </span>

            </div>

            <div class="input-group">

                <label asp-for="CodigoGerente">
                    Gerente
                </label>

                <select asp-for="CodigoGerente"
                        class="form-select"
                        asp-items="ViewBag.ListaGerentes">

                    <option value="">
                        -- Selecione um Gerente --
                    </option>

                </select>

                <small class="field-help">
                    Selecione um funcionário já cadastrado para ser o gerente.
                </small>

                <span asp-validation-for="CodigoGerente"
                      class="text-danger">
                </span>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Funcionário
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
