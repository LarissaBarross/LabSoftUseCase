@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Editar Funcionário";
}

<div class="form-page">

    <!-- Cabeçalho -->
    <div class="page-header">

        <div>
            <span class="page-subtitle">CADASTROS</span>

            <h1>Editar Funcionário</h1>

            <p>
                Altere as informações do funcionário cadastrado.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Voltar
        </a>

    </div>


    <!-- Formulário -->
    <div class="form-card">

        <div class="form-card-header">

            <div class="form-icon">
                👤
            </div>

            <div>
                <h2>Informações do funcionário</h2>

                <p>
                    Atualize os dados abaixo.
                </p>
            </div>

        </div>


        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Codigo" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>


            <!-- Nome -->
            <div class="input-group">

                <label asp-for="Nome">
                    Nome completo
                </label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Digite o nome do funcionário"
                       autocomplete="off" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>


            <!-- Cargo -->
            <div class="input-group">

                <label asp-for="Cargo">
                    Cargo
                </label>

                <input asp-for="Cargo"
                       class="form-control"
                       placeholder="Digite o cargo do funcionário"
                       autocomplete="off" />

                <span asp-validation-for="Cargo"
                      class="text-danger">
                </span>

            </div>


            <!-- Botões -->
            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancelar
                </a>

                <button type="submit"
                        class="save-button">
                    ✓ Salvar Alterações
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}